{
  "name": "@remote-vscode/controller-desktop",
  "version": "1.0.0",
  "description": "Desktop Application for controlling remote isolated VS Code instances",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
