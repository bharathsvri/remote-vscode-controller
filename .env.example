# Remote VS Code Controller - Environment Configuration Example

# Signaling Server Configuration
SIGNALING_PORT=4000
SIGNALING_HOST=0.0.0.0
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
CORS_ORIGIN=*

# WebRTC STUN / TURN Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# Provider Agent Configuration
PROVIDER_PORT=4001
PROVIDER_DEVICE_NAME=My-Windows-Workstation
PROVIDER_SIGNALING_URL=ws://localhost:4000/ws
PROVIDER_STORAGE_DIR=./data/provider-storage
PROVIDER_DEFAULT_WORKSPACE=D:/Work/Repositories
PROVIDER_AUTO_APPROVE=true
PROVIDER_FULL_ACCESS=true
# Set to custom IP or leave blank to auto-detect LAN IP (e.g., 192.168.1.254)
PROVIDER_HOST=
PROVIDER_BIND_HOST=0.0.0.0

# Controller Desktop Configuration
CONTROLLER_SIGNALING_URL=ws://localhost:4000/ws
